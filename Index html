Aquí tienes el código completo y corregido en un único bloque de texto listo para que lo guardes directamente como index.html y lo subas a tu repositorio de GitHub.
Se optimizaron las medidas y proporciones para que se vea perfectamente en la pantalla de cualquier celular sin cortes ni pantallas en blanco:
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador: Humedal vs Filtro Casero</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        #simCanvas {
            touch-action: none;
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-12">

    <!-- Encabezado -->
    <header class="bg-emerald-700 text-white py-5 shadow-md mb-6">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h1 class="text-2xl md:text-3xl font-bold">Misma idea, distinto tamaño</h1>
            <p class="text-emerald-100 text-sm md:text-base mt-1">Cómo el humedal natural y el filtro casero purifican el agua capa por capa</p>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 space-y-6">

        <!-- SIMULACIÓN INTERACTIVA -->
        <section class="bg-white rounded-2xl shadow-lg p-4 md:p-6 border border-slate-200">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4 border-b pb-3">
                <div>
                    <h2 class="text-xl md:text-2xl font-bold text-slate-800 flex items-center gap-2">
                        <span>🌊</span> Filtración en Tiempo Real
                    </h2>
                    <p class="text-slate-500 text-xs md:text-sm">Las partículas contaminantes son retenidas según la densidad de cada capa.</p>
                </div>
                
                <!-- Selector de Modo -->
                <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200 w-full sm:w-auto">
                    <button id="btnHumedal" onclick="setMode('humedal')" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all bg-emerald-600 text-white shadow-sm">
                        🌿 Humedal
                    </button>
                    <button id="btnBotella" onclick="setMode('botella')" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all text-slate-600 hover:text-slate-900">
                        🍾 Botella
                    </button>
                </div>
            </div>

            <!-- Canvas de Simulación Responsivo -->
            <div class="relative w-full flex justify-center bg-slate-900 rounded-xl overflow-hidden shadow-inner p-2 border border-slate-800">
                <canvas id="simCanvas" width="400" height="520" class="block bg-slate-950 rounded-lg"></canvas>
            </div>

            <!-- Panel de Control Corto -->
            <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button id="btnPlay" onclick="togglePlay()" class="flex-1 sm:flex-none bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg text-xs md:text-sm transition-colors">
                        Pausar
                    </button>
                    <button onclick="resetSim()" class="flex-1 sm:flex-none bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-2 px-4 rounded-lg text-xs md:text-sm transition-colors">
                        Reiniciar
                    </button>
                </div>

                <!-- Leyenda de partículas -->
                <div class="flex flex-wrap justify-center sm:justify-end gap-3 text-xs font-medium">
                    <div class="flex items-center gap-1">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-800 inline-block"></span> Sólidos
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span> Nutrientes
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-300 inline-block"></span> Arena
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 inline-block"></span> Agua Limpia
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE INFORMACIÓN Y TEORÍA -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 border-t-4 border-t-emerald-500">
                <div class="text-2xl mb-1">🌿</div>
                <h3 class="font-bold text-base text-slate-800 mb-1">Filtración Física</h3>
                <p class="text-slate-600 text-xs leading-relaxed">
                    Al disminuir la velocidad del agua, los sólidos caen por gravedad y quedan atrapados entre las raíces y poros.
                </p>
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 border-t-4 border-t-teal-500">
                <div class="text-2xl mb-1">🌱</div>
                <h3 class="font-bold text-base text-slate-800 mb-1">Fitorremediación</h3>
                <p class="text-slate-600 text-xs leading-relaxed">
                    Las raíces absorben nitrógeno, fósforo y metales pesados. Además, oxigenan el suelo para las bacterias.
                </p>
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 border-t-4 border-t-cyan-500">
                <div class="text-2xl mb-1">🦠</div>
                <h3 class="font-bold text-base text-slate-800 mb-1">Biodegradación</h3>
                <p class="text-slate-600 text-xs leading-relaxed">
                    La materia orgánica y la grava albergan microorganismos que transforman compuestos nocivos en sustancias inofensivas.
                </p>
            </div>
        </section>

        <!-- TABLA DE CORRESPONDENCIA DE CAPAS -->
        <section class="bg-white rounded-2xl shadow-lg p-4 md:p-6 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
                <span>📊</span> Equivalencia Capa por Capa
            </h3>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-100 border-b border-slate-200 text-slate-700 text-xs md:text-sm">
                            <th class="p-2.5 rounded-l-lg">Humedal Natural</th>
                            <th class="p-2.5">Filtro Casero</th>
                            <th class="p-2.5 rounded-r-lg">Función Principal</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs md:text-sm text-slate-600">
                        <tr class="hover:bg-slate-50">
                            <td class="p-2.5 font-semibold text-emerald-800">1. Vegetación acuática</td>
                            <td class="p-2.5 font-semibold text-slate-700">Algodón / Fibra</td>
                            <td class="p-2.5">Retiene sólidos grandes y sedimentos flotantes.</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-2.5 font-semibold text-emerald-800">2. Materia orgánica</td>
                            <td class="p-2.5 font-semibold text-slate-700">Carbón Activado</td>
                            <td class="p-2.5">Absorbe químicos, pesticidas y malos olores.</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-2.5 font-semibold text-emerald-800">3. Arena fina</td>
                            <td class="p-2.5 font-semibold text-slate-700">Arena de río</td>
                            <td class="p-2.5">Atrapa sedimentos finos y microplásticos.</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-2.5 font-semibold text-emerald-800">4. Piedras / Grava</td>
                            <td class="p-2.5 font-semibold text-slate-700">Piedras / Cantos</td>
                            <td class="p-2.5">Drenaje rápido y soporte de las capas superiores.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- SCRIPT DE ANIMACIÓN CANVAS -->
    <script>
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');

        let mode = 'humedal';
        let isRunning = true;
        let particles = [];

        const layers = [
            { id: 1, nameH: "1. Vegetación", nameB: "1. Algodón", yStart: 60, yEnd: 140, color: "rgba(34, 197, 94, 0.4)" },
            { id: 2, nameH: "2. Mat. Orgánica", nameB: "2. Carbón Activado", yStart: 140, yEnd: 220, color: "rgba(51, 65, 85, 0.55)" },
            { id: 3, nameH: "3. Arena", nameB: "3. Arena", yStart: 220, yEnd: 310, color: "rgba(217, 119, 6, 0.4)" },
            { id: 4, nameH: "4. Piedras y Grava", nameB: "4. Piedras", yStart: 310, yEnd: 400, color: "rgba(100, 116, 139, 0.5)" }
        ];

        function setMode(newMode) {
            mode = newMode;
            document.getElementById('btnHumedal').className = mode === 'humedal' 
                ? "flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all bg-emerald-600 text-white shadow-sm"
                : "flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all text-slate-600 hover:text-slate-900";
            document.getElementById('btnBotella').className = mode === 'botella' 
                ? "flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all bg-emerald-600 text-white shadow-sm"
                : "flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-medium text-xs md:text-sm transition-all text-slate-600 hover:text-slate-900";
            resetSim();
        }

        function togglePlay() {
            isRunning = !isRunning;
            document.getElementById('btnPlay').innerText = isRunning ? "Pausar" : "Reanudar";
        }

        function resetSim() {
            particles = [];
        }

        class Particle {
            constructor() {
                this.x = 80 + Math.random() * 240;
                this.y = 10;
                this.speedY = 1 + Math.random() * 1.5;
                this.speedX = (Math.random() - 0.5) * 0.4;
                
                const rand = Math.random();
                if (rand < 0.35) {
                    this.type = 'large';
                    this.radius = 5;
                    this.color = '#a16207';
                } else if (rand < 0.65) {
                    this.type = 'nutrient';
                    this.radius = 3.5;
                    this.color = '#34d399';
                } else {
                    this.type = 'fine';
                    this.radius = 2.5;
                    this.color = '#fde047';
                }
                
                this.stopped = false;
            }

            update() {
                if (this.stopped) return;

                this.y += this.speedY;
                this.x += this.speedX;

                if (this.type === 'large' && this.y > 90 && this.y < 140) {
                    if (Math.random() < 0.08) this.stopped = true;
                }
                if (this.type === 'nutrient' && this.y > 170 && this.y < 220) {
                    if (Math.random() < 0.07) this.stopped = true;
                }
                if (this.type === 'fine' && this.y > 250 && this.y < 310) {
                    if (Math.random() < 0.06) this.stopped = true;
                }

                if (this.y > 400) {
                    this.type = 'water';
                    this.color = '#38bdf8';
                    this.radius = 3;
                }

                if (this.y > 465) {
                    this.y = 465;
                    this.speedY = 0;
                    this.speedX = 0;
                }
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.fill();
                ctx.closePath();
            }
        }

        function drawBackground() {
            ctx.fillStyle = '#020617';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            const left = 60;
            const width = 280;

            layers.forEach(layer => {
                ctx.fillStyle = layer.color;
                ctx.fillRect(left, layer.yStart, width, layer.yEnd - layer.yStart);

                ctx.fillStyle = '#f8fafc';
                ctx.font = 'bold 12px sans-serif';
                const label = mode === 'humedal' ? layer.nameH : layer.nameB;
                ctx.fillText(label, left + 10, layer.yStart + 25);
            });

            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 3;
            ctx.strokeRect(left, 60, width, 340);

            ctx.fillStyle = 'rgba(14, 165, 233, 0.25)';
            ctx.fillRect(left + 20, 415, width - 40, 60);
            ctx.strokeStyle = '#38bdf8';
            ctx.strokeRect(left + 20, 415, width - 40, 60);

            ctx.fillStyle = '#7dd3fc';
            ctx.font = 'bold 13px sans-serif';
            ctx.fillText('💧 Agua Purificada', left + width / 2 - 55, 450);
        }

        function animate() {
            if (isRunning) {
                if (Math.random() < 0.35) {
                    particles.push(new Particle());
                }

                if (particles.length > 250) {
                    particles.shift();
                }
            }

            drawBackground();

            particles.forEach(p => {
                if (isRunning) p.update();
                p.draw();
            });

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>

